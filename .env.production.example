# ==============================================================================
# JISR Arabic Production Environment Variables Template
# Copy this file to .env.production and fill in with production credentials.
# ==============================================================================

# Application Environment
FAHIM_ENV=production
HOST_PORT=80

# Secret Key for JWT signature (generate via: python -c "import secrets; print(secrets.token_urlsafe(48))")
FAHIM_SECRET_KEY=change_this_to_a_secure_random_production_key_minimum_48_chars

# Database Configuration (Managed Neon PostgreSQL with Connection Pooler)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://jisr_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Tuning for 1,000-Student Peak Concurrency
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache & Background Queue (Points to internal container service or managed AWS ElastiCache)
REDIS_URL=redis://redis:6379/0

# Allowed CORS Origins (Comma-separated, mandatory in production mode)
FAHIM_CORS_ORIGINS=https://jisr.ae,https://app.jisr.ae,https://admin.jisr.ae

# Google Gemini AI API Key (For adaptive AI tutoring and curriculum vision analysis)
GEMINI_API_KEY=

# Concurrency & Performance
WEB_CONCURRENCY=2
FASTAPI_THREAD_LIMIT=200
RUN_MIGRATIONS=1

# Storage Paths
FAHIM_AUDIO_CACHE_DIR=/app/tmp/audio-cache

# Payment Provider Integration (Required in production: stripe or paypal)
FAHIM_PAYMENT_PROVIDER=stripe
FAHIM_PAYMENT_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_minimum_24_chars
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Transactional Email / SMTP (Required for production OTP verification)
FAHIM_SMTP_HOST=smtp.sendgrid.net
FAHIM_SMTP_PORT=587
FAHIM_SMTP_USER=apikey
FAHIM_SMTP_PASS=your_smtp_password_or_api_key
FAHIM_SMTP_FROM=noreply@jisr-arabic.com

