# Normalise line endings in the repository; Windows checkouts keep CRLF locally.
* text=auto

*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
*.apk  binary
*.aab  binary
*.db   binary
*.ttf  binary
*.otf  binary
