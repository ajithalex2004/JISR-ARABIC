# ==============================================================================
# JISR Arabic (فهيم) — Git Ignore Policy
# ==============================================================================

# 1. Environment & Secret Credentials (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Cloud & Service Account Credentials
jisr-arabic-*.json
*-credentials.json
*service-account*.json
*credentials*.json
client_secret*.json
google-services.json
GoogleService-Info.plist

# Mobile Keystores & Properties
*.jks
*.keystore
key.properties
upload-keystore.jks
private_keys/
certificates/

# 2. Executables, Compiled Binaries & Mobile Release Artifacts
*.exe
*.dll
*.so
*.dylib
*.apk
*.aab
*.ipa
*.app
*.dmg
*.iso
*.msi
*.bin

# Root binaries
cloudflared.exe
Fahim-Arabic-Learning.apk
jisr*.apk
JISR*.apk

# 3. Database & Local SQLite Files
*.db
*.sqlite
*.sqlite3
fahim.db
jisr.db
backend/fahim.db

# 4. Large Data, Dumps & Extracted OCR Datasets
Knowledge Base/
pdf_pages_sample/
vision-output/
vision-output-new/
*.pdf
scratch/
scratch_*
test_results.txt
set

# 5. Infrastructure & Terraform State / Plans
terraform/.terraform/
terraform/*.tfplan
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/override.tf
terraform/*_override.tf
!terraform/.terraform.lock.hcl

# 6. Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 7. Node / React (Web Client)
node_modules/
frontend/dist/
frontend/build/
.npm
.eslintcache
.vite/

# 8. Mobile / Flutter & Native Platform Builds
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/.last_build_id
mobile/.pub-cache/
mobile/.pub/
app.*.symbols
app.*.map.json

# 9. Local Cache & Temporary Files
tmp/
audio_cache/
task_artifacts/
*.log
npm-debug.log*
yarn-debug.log*

# 10. IDEs & OS Metadata
.vscode/
.idea/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
