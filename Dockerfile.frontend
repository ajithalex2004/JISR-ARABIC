# ==============================================================================
# JISR Arabic Frontend & Web Gateway - Production Multi-Stage Nginx Dockerfile
# ==============================================================================

# Stage 1: Build Frontend Single Page Application
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies with clean cache
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source code and compile production Vite bundle.
# VITE_API_URL is empty for docker-compose (same-origin /api via nginx) and set to the
# public API URL on Railway.
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}
COPY frontend/ ./
RUN npm run build

# Stage 2: Hardened Production Nginx Gateway
FROM nginx:1.27-alpine AS runtime

# nginx/nginx.conf proxies /api to the compose "api" service; Railway uses
# nginx/nginx.railway.conf (static only).
ARG NGINX_CONF=nginx/nginx.conf

# Remove default Nginx HTML files
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled production bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy optimized production Nginx configuration
COPY ${NGINX_CONF} /etc/nginx/nginx.conf
COPY nginx/security_headers.conf /etc/nginx/security_headers.conf

# Add healthcheck for web gateway
HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost/ || wget -q --spider http://localhost:8080/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
