# ==============================================================================
# JISR Arabic Frontend & Web Gateway - Production Multi-Stage Nginx Dockerfile
# ==============================================================================

# Stage 1: Build Frontend Single Page Application
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies with clean cache
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source code and compile production Vite bundle
COPY frontend/ ./
RUN npm run build

# Stage 2: Hardened Production Nginx Gateway
FROM nginx:1.27-alpine AS runtime

# Remove default Nginx HTML files
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled production bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy optimized production Nginx configuration
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Add healthcheck for web gateway
HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
