# Copy to secrets.env (git-ignored), fill in real values, then deploy.
# kustomize turns this file into the Secret "jisr-secrets". Never commit secrets.env.

# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Reuse the current production value so existing logins keep working (32+ characters).
FAHIM_SECRET_KEY=

# 24+ characters; the Stripe webhook signing secret once payments are live.
FAHIM_PAYMENT_WEBHOOK_SECRET=

GEMINI_API_KEY=
RESEND_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Only if sending mail over SMTP instead of Resend.
FAHIM_SMTP_HOST=
FAHIM_SMTP_PORT=587
FAHIM_SMTP_USER=
FAHIM_SMTP_PASS=
