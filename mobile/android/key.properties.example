# Template for Android Release Keystore signing properties
# Copy this file to mobile/android/key.properties and replace with real credentials.
# NEVER commit key.properties or .jks / .keystore files to version control.
#
# Generate a keystore with:
# keytool -genkey -v -keystore mobile/android/app/upload-keystore.jks -alias jisr_upload -keyalg RSA -keysize 2048 -validity 10000

keyAlias=jisr_upload
keyPassword=YOUR_KEY_PASSWORD
storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
